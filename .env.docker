NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://jud:admin@db:5432/ordolite

JWT_SECRET=change-me-to-a-very-long-random-string-1
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-to-a-very-long-random-string-2
JWT_REFRESH_TTL=7d

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
ALLOWED_MIME=image/webp/image/jpeg,image/png,application/pdf

CORS_ORIGIN=*

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM="OrdoLite Support <support@ordolite.local>"

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# DB interne au réseau docker
DATABASE_URL=postgresql://jud:admin@db:5432/ordolite

# JWT
JWT_SECRET=secret-mots
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=7d

# Uploads (mappé au volume uploads_data)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
ALLOWED_MIME=image/jpeg,image/png,application/pdf

# CORS
CORS_ORIGIN=*

# SMTP (mets tes vrais creds)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="OrdoLite Support <support@ordolite.com>"

SWAGGER_SERVER=http://localhost:3000/api/v1

# -------- Application --------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# -------- Base de données --------
# Format: postgresql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql://jud:admin@localhost:5432/ordolite

# JWT
JWT_SECRET=change-me-to-a-very-long-random-string-1_________________________
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-to-a-very-long-random-string-2_________________
JWT_REFRESH_TTL=7d

# -------- Uploads --------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
ALLOWED_MIME=image/jpeg,image/png,application/pdf

# -------- Sécurité HTTP --------
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# -------- Email (reset password) --------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM="OrdoLite Support <support@ordolite.local>"

# -------- Swagger --------
SWAGGER_SERVER=http://localhost:3000/api/v1

# =========================
# SMTP (envoi d’e-mails)
# =========================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="OrdoLite Support <support@ordolite.com>"